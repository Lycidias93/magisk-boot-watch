# Boot Watch Collector v0.2.5-test.1 config
# Runtime: /data/adb/boot-watch
# Exports: /storage/emulated/0/Download/boot-watch-<run_id>.tar.gz
# Result logs: /storage/emulated/0/Download/boot-watch-<run_id>-result.txt and boot-watch-last-result.txt
BOOT_WATCH_VERSION=0.2.5-test.1
BOOT_WATCH_VERSION_CODE=25
BOOT_WATCH_MODE=boot
BOOT_WAIT_MAX_LOOPS=60
BOOT_WAIT_SLEEP_SECONDS=5
STAGE_DELAYS_SECONDS="20 90 240"
LOGCAT_TAIL_LINES=800
LOGCAT_PATTERN_LINES=1200
ANR_MAX_FILES=30
TOMBSTONE_MAX_FILES=30
DROPBOX_MAX_FILES=80
LSPD_LOG_MAX_FILES=20
PIDD_LOG_MAX_FILES=30
ASHREXCUE_MAX_FILES=80

# Extended module runtime log tails are opt-in; standard profile keeps content collection disabled.
PBW_COLLECT_MODULE_LOGS=0
